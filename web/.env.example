# ── Sesión (REQUERIDO en producción) ──────────────────────────────────────────
# Firma HMAC de la cookie de sesión (`cb_session`, antes `urb_session`). Generar con:  openssl rand -hex 32
SESSION_SECRET=

# ── Persistencia (Railway: apuntar a un Volume montado) ───────────────────────
# Si no defines estas vars se usa <cwd>/data y <cwd>/public/uploads (sirve para dev).
# En Railway monta un Volume en /data y pon:
#   URBNBEE_DATA_DIR=/data/json
#   URBNBEE_UPLOADS_DIR=/data/uploads
URBNBEE_DATA_DIR=
URBNBEE_UPLOADS_DIR=

# Promueve a admin al arranque si el usuario ya existe (correo en minúsculas).
# Ej.: URBNBEE_ADMIN_EMAIL=admin@urbnbee.net
URBNBEE_ADMIN_EMAIL=

# ── MySQL (opcional; sin esto la app sigue usando JSON en URBNBEE_DATA_DIR) ────
# URL tipo: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway: copia la variable que expone el plugin MySQL (p. ej. MYSQL_URL o DATABASE_URL).
DATABASE_URL=
# Alternativa por variables sueltas:
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ── Integración BeeAgent / URBNBEEAI.com (server-to-server + CORS) ────────────
# Secreto compartido: enviar como Authorization: Bearer <valor> desde urbnbeeai.com.
# Generar: openssl rand -hex 32
URBNBEE_PARTNER_API_SECRET=
# Opcional: firma HMAC de webhooks BeeAgent→Urbnbee (si vacío, usa URBNBEE_PARTNER_API_SECRET).
URBNBEE_PARTNER_WEBHOOK_SECRET=
# Orígenes CORS separados por coma (default: https://urbnbeeai.com,https://www.urbnbeeai.com).
URBNBEE_PARTNER_ORIGINS=
# URL signup BeeAgent (CTA en panel host → Integraciones)
# URBNBEEAI_SIGNUP_URL=https://www.urbnbeeai.com/signup
# Orígenes permitidos para return_url del flujo Conectar (default www + apex urbnbeeai.com).
# URBNBEEAI_CONNECT_RETURN_ORIGINS=https://www.urbnbeeai.com,https://urbnbeeai.com
# URBNBEEAI_CONNECT_START_URL=https://www.urbnbeeai.com/integrations/cabibee/start
# Origen de urbnbeeai.com para el chat del listing (default https://www.urbnbeeai.com).
# URBNBEEAI_API_URL=https://www.urbnbeeai.com
# Receptor de webhooks salientes (C10). Default: https://www.urbnbeeai.com/api/integrations/cabibee/webhooks
# URBNBEEAI_WEBHOOK_URL=

# ── Historial crediticio (screening) ─────────────────────────────────────────
# Se lee al compilar: cambiarlo requiere un deploy nuevo. La app de Android nunca lo muestra.
# NEXT_PUBLIC_CREDIT_CHECK_ENABLED=1
# Sin proveedor, el cobro funciona pero el resultado queda "Pendiente del proveedor".
# CREDIT_BUREAU_PROVIDER=kibai
# KIBAI_API_URL=https://...
# KIBAI_API_KEY=
# KIBAI_WEBHOOK_SECRET=
# Webhook que se registra con el proveedor: https://app.cabibee.com/api/webhooks/credit-bureau

# ── Stripe (requerido para pagos y suscripción de verificación) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Membresía huésped y screening: los montos viven en /admin/pricing (catálogo), no
# en Price IDs. El screening es un cobro aparte (metadata.kind=guest_screening).
# Membresía huésped: LEGADO. Los planes vigentes (pase por reserva, 6 y 12 meses) se
# editan en /admin/pricing y se cobran con monto libre, así que no necesitan Price IDs.
# Estas variables sólo se usan mientras el catálogo no tenga precios; cuando lo tenga,
# vacíalas para no dejar dos precios vivos.
STRIPE_PRICE_VERIFICATION_MX_MONTHLY=
STRIPE_PRICE_VERIFICATION_MX_ANNUAL=
STRIPE_PRICE_VERIFICATION_US_MONTHLY=
STRIPE_PRICE_VERIFICATION_US_ANNUAL=
# Legado (una sola moneda): si las de arriba están vacías, se usan estas.
STRIPE_PRICE_VERIFICATION_MONTHLY=
STRIPE_PRICE_VERIFICATION_ANNUAL=

# true = además de membresía activa exige KYC verificado (Stripe Identity + webhooks en el mismo endpoint).
STRIPE_IDENTITY_ENABLED=false

# Cifra las secret keys de Stripe de cada anfitrión (AES-256-GCM). 32 bytes en hex:
#   openssl rand -hex 32
# Sin esto, /host/settings/pagos se ve pero no puede guardar. Tú la pones en Railway.
HOST_PAYMENT_CREDS_KEY=

# Cargo plataforma sobre el total estancia+limpieza al pagar la reserva (por defecto 1).
# Si la estancia se cobra en el Stripe del anfitrión, este cargo no se suma en Checkout (Q1).
PLATFORM_BOOKING_FEE_PERCENT=1
# Opcional: mínimo en MXN si quieres un piso al fee (0 = desactivado).
PLATFORM_BOOKING_FEE_MIN_MXN=0

# ── Blog bot (opcional): generador de posts con LLM ───────────────────────────
# Orden de precedencia: BLOG_BOT_OPENAI_API_KEY → OPENAI_API_KEY → clave guardada en /admin.
BLOG_BOT_OPENAI_API_KEY=
OPENAI_API_KEY=

# Cron (opcional): GET /api/cron/blog-scheduled — Authorization: Bearer … o ?secret=
CRON_SECRET=

# Notificaciones push de la app (/app). Genera el par con: npx web-push generate-vapid-keys
# Si cambias las llaves, todos los dispositivos tienen que volver a activar los avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@cabibee.com

# Importación asistida de listings (capturas + visión OpenAI). false para desactivar.
# Si no se define, se habilita cuando hay OPENAI_API_KEY o BLOG_BOT_OPENAI_API_KEY.
LISTING_IMPORT_AI_ENABLED=
# LISTING_IMPORT_OPENAI_MODEL=gpt-4o-mini
# LISTING_IMPORT_TIMEOUT_MS=90000
# LISTING_IMPORT_INPUT_USD_PER_1M=0.15
# LISTING_IMPORT_OUTPUT_USD_PER_1M=0.6
